+            Row::CornerRadius,
+        ],
+    }
+}
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Cat {
+    Special,
+    Letters,
+    Numbers,
+    Keys,
+    Actions,
+}
+const CATS: [(Cat, &str); 5] = [
+    (Cat::Special, "Special"),
+    (Cat::Letters, "A-Z"),
+    (Cat::Numbers, "0-9 F"),
+    (Cat::Keys, "Keys"),
+    (Cat::Actions, "Actions"),
+];
+fn category(token: &str) -> Cat {
+    if token == UNKNOWN
+        || token == HIDE_BUTTONS
+        || token == MOUSE_TOGGLE
+        || token == KEYBOARD
+        || matches!(
+            token,
+            "action:key.attack" | "action:key.use" | "action:key.pickItem"
+        )
+    {
+        return Cat::Special;
+    }
+    if token.starts_with("action:") {
+        return Cat::Actions;
+    }
+    let name = token.strip_prefix("key.keyboard.").unwrap_or(token);
+    if name.len() == 1 && name.as_bytes()[0].is_ascii_lowercase() {
+        Cat::Letters
+    } else if name.len() == 1
+        || (name.starts_with('f') && name[1..].chars().all(|c| c.is_ascii_digit()))
+    {
+        Cat::Numbers
+    } else {
+        Cat::Keys
+    }
+}
